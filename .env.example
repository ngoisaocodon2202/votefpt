# 1. PostgreSQL Connection (Neon.tech / Supabase / Vercel Postgres Free Tier)
# Khi tích hợp Neon hoặc Supabase từ Vercel Marketplace, biến DATABASE_URL / POSTGRES_URL sẽ được tự động gắn.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Auth.js / NextAuth Configuration
# Tạo chuỗi ngẫu nhiên bằng: npx auth secret (hoặc openssl rand -base64 32)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
# Không bắt buộc trên vercel.app (NextAuth v5 tự nhận diện qua VERCEL_URL); chỉ cần bật nếu gắn custom domain riêng:
# AUTH_URL="https://ten-du-an.vercel.app"

# 3. Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
# Authorized JavaScript origins:
#   http://localhost:3000
#   https://ten-du-an.vercel.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://ten-du-an.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# 4. Contest Timezone (Daily 3-vote reset at 00:00:00 local time)
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# 5. Dedicated /admin Portal Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"
